/// @description  scr_set_reciever(on-script,off-script);
/// @param on-script
/// @param off-script
function scr_set_reciever(argument0, argument1) {
	/*
	    run the off-script and on-script codes
	    (once) each time the reciever value
	    is toggled
	*/

	switch_on_script = argument0;
	switch_off_script = argument1;



}
