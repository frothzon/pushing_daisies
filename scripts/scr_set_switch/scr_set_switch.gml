/// @description  scr_set_switch(trigger_obj,trigger_qty,timer[s]);
/// @param trigger_obj
/// @param trigger_qty
/// @param timer[s]
function scr_set_switch(argument0, argument1, argument2) {
	/*
	    set the object and quantity that will flip
	    the trigger on
	*/

	trigger_obj = argument0;
	trigger_qty = argument1;
	time_keeper = argument2*room_speed;



}
