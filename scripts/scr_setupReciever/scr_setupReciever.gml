/// @description  scr_setupReciever
function scr_setupReciever() {
	/*
	    set up the switch variables
	    necessary to create game logic
	*/


	/// create variables
	team    = 0;          /// only effect matching recievers
	value   = false;      /// value of reciever


	/// flip on / off reciever
	collisionIsSet = false;
	switch_on_script = -1;
	switch_off_script = -1;



}
