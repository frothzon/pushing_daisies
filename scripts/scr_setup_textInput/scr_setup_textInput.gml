/// @description  scr_setup_textInput();
function scr_setup_textInput() {
	/*------------------------------------
	Setup text input box data
	--------------------------------------*/

	input_font = fnt_size16;
	input_data = scr_make_input(16,48,12,input_font);
	input_select = -1;
	input_string = "";
	output_x = 16;
	output_y = 16;
	finished = false;
	caps = true;



}
